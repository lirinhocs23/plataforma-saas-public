# Aplicacao
APP_NAME="MJDev Digital"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://catalogo.exemplo.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_KEY=generate-a-long-random-secret-at-deploy-time
TRUSTED_PROXY_IPS=
LEGAL_OPERATOR_NAME="replace-with-the-legal-operator-name"
PRIVACY_CONTACT_EMAIL=privacy-contact@example.invalid

# Sessao e cookies
SESSION_NAME=mjdev_session
SESSION_LIFETIME_MINUTES=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=Lax
REQUIRE_PRIVILEGED_2FA=false

# Protecao anti-robo (Cloudflare Turnstile)
# Cadastre o dominio publico no widget e mantenha a chave secreta somente no servidor.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# MySQL interno do EasyPanel
# Usada somente pelo serviço MySQL/Compose; nunca entregue à aplicação PHP.
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-secret
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mjdev_delivery
DB_USERNAME=mjdev_app
DB_PASSWORD=replace-with-a-strong-secret
DB_CHARSET=utf8mb4
DB_STARTUP_MAX_ATTEMPTS=30

# Pedidos e armazenamento persistente
UPLOAD_MAX_BYTES=5242880
TRACKING_LINK_TTL_DAYS=30

# E-mail transacional (recuperação de senha)
MAIL_ENABLED=false
MAIL_HOST=smtp.example.invalid
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.invalid
MAIL_FROM_NAME="MJDev Digital"

# Assinaturas da plataforma (Mercado Pago)
# Mantenha sandbox durante a homologacao. Segredos reais ficam somente no EasyPanel.
MERCADOPAGO_ENV=sandbox
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# URL no Mercado Pago: https://seu-dominio/webhooks/mercadopago
MERCADOPAGO_MONTHLY_PLAN_ID=
MERCADOPAGO_ANNUAL_PLAN_ID=

